{
  "enabled": true,
  "kpiCalculationRulesEnabled": true,
  "companyComparisonRulesEnabled": true,
  "performanceScoringRulesEnabled": true,
  "validationRulesEnabled": true,
  "healthMonitoringRulesEnabled": true,
  "neverExposeCredentials": true,
