{
  "enabled": true,
  "cashflowRulesEnabled": true,
  "validationRulesEnabled": true,
  "executiveReportingEnabled": true,
  "requireGrandKingApproval": true,
  "requirePillowCommandConfirmation": true,
  "workerId": "wkr-cashflow-01",
  "workerName": "Cashflow Worker",
  "factory": "capital-factory",
  "department": "capital",
  "role": "role-analyst-cashflow",
  "defaultCurrency": "SGD",
  "reportingFrequencies": ["daily", "weekly", "monthly", "annual", "custom"],
  "integrationTargets": [
    "capital_factory_core",
    "accounting_worker",
    "worker_registry",
    "worker_lifecycle",
    "worker_assignment_engine",
    "executive_reporting_runtime",
    "audit_runtime",
    "worker_recovery_system"
