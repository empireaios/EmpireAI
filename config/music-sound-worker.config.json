{
  "enabled": true,
  "audioRulesEnabled": true,
  "validationRulesEnabled": true,
  "executiveReportingEnabled": true,
  "workerId": "wkr-music-sound-01",
  "workerName": "Music & Sound Worker",
  "factory": "media-factory",
  "department": "media",
  "role": "role-creator-music-sound",
  "defaultMood": "curious",
  "allowGeneratedMusicByDefault": true,
  "supportedAudioTypes": [
    "background_music",
    "intro_music",
    "outro_music",
    "ambient_audio",
    "transition_effects",
    "notification_sounds",
    "cinematic_effects",
    "generated_music"
  ],
  "supportedMoods": [
    "neutral",
    "uplifting",
    "tense",
    "calm",
    "energetic",
    "cinematic",
    "curious",
    "inspirational"
  ],
  "integrationTargets": [
    "worker_registry",
    "worker_lifecycle",
    "worker_assignment_engine",
    "script_worker",
    "video_assembly_worker",
    "executive_reporting_runtime",
    "worker_performance_review",
    "worker_recovery_system"
  ],
  "retryPolicyAttempts": 3,
  "timeoutMs": 5000,
  "loggingLevel": "info",
  "neverAssembleVideos": true,
  "neverPublishMedia": true,
  "neverOverridePillow": true,
  "neverOverrideGrandKing": true,
  "neverImplementQ414OrLater": true,
  "neverUseUnapprovedCopyrightedAssets": true,
  "preserveCompleteAssetTraceability": true,
  "preserveLicensingInformation": true,
  "preserveTimelineSynchronization": true,
  "validateCopyrightCompliance": true,
  "preserveAuditHistory": true,
  "structuralSignalOnly": true
}
