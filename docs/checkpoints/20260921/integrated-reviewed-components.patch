+      assert.ok(performance.now() - startedAt < 9_000, "must recover before the test safety timer");
+    } finally {
+      clearTimeout(safety);
+      if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+    }
+  });
+});
