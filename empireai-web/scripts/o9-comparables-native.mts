import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import {once} from 'node:events';import assert from 'node:assert/strict';import {build} from 'esbuild';import {chromium} from 'playwright';import {GET} from '../app/api/owner/commerce/comparables/route';
const [api,token,out]=process.argv.slice(2);if(!api||!token||!out)throw Error('api token out required');process.env.BRAIN_API_URL=api;fs.mkdirSync(out,{recursive:true});
const bundle=await build({stdin:{contents:`import React,{useEffect,useState}from'react';import{createRoot}from'react-dom/client';import{ObservedCandidates}from'./components/owner/work7/ObservedCandidates';function Exam(){const[data,setData]=useState(null);const[error,setError]=useState('');useEffect(()=>{fetch('/api/owner/commerce/comparables',{credentials:'include',cache:'no-store'}).then(async r=>{if(!r.ok)throw Error('Evidence unavailable');setData(await r.json())}).catch(e=>setError(e.message))},[]);return error?<p role="alert">{error}</p>:data?<ObservedCandidates value={data.observedCandidates} comparableContext={data}/>:<p>Loading authenticated evidence</p>}createRoot(document.getElementById('root')).render(<Exam/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,outfile:'bundle.js',format:'iife',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
let origin='';const requests:Array<{method:string|undefined;status:number}>=[];const server=http.createServer(async(req,res)=>{try{if(req.url==='/bundle.js'||req.url==='/bundle.css'){const suffix=req.url.slice(1);const output=bundle.outputFiles.find(f=>f.path.endsWith(suffix));res.setHeader('content-type',suffix.endsWith('css')?'text/css':'text/javascript');res.end(output?.text??'');return;}if(req.url==='/api/owner/commerce/comparables'){const response=await GET(new Request(origin+req.url,{headers:req.headers as HeadersInit}));requests.push({method:req.method,status:response.status});res.statusCode=response.status;response.headers.forEach((v,k)=>res.setHeader(k,v));res.end(await response.text());return;}res.setHeader('content-type','text/html');res.end('<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/bundle.css"><style>body{font:16px Arial;color:#294363;background:#f5f9fc;margin:16px}*{box-sizing:border-box}main{max-width:1000px;margin:auto}</style><main><p>ISOLATED CONNECTED EXAM · genuine retained observations · no production change</p><div id="root"></div></main><script src="/bundle.js"></script>');}catch(e){res.statusCode=500;res.end(String(e))}});server.listen(0,'127.0.0.1');await once(server,'listening');origin='http://127.0.0.1:'+(server.address() as {port:number}).port;
const browser=await chromium.launch({executablePath:'/tmp/work8-chromium/chromium',headless:true,args:['--no-sandbox','--disable-dev-shm-usage']});try{const context=await browser.newContext({viewport:{width:1365,height:900}});await context.route('**/*',r=>new URL(r.request().url()).origin===origin?r.continue():r.abort());const page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin);await page.getByRole('alert').waitFor();assert.equal(requests.at(-1)?.['status'],401);await context.addCookies([{name:'empireai_session',value:token,url:origin}]);await page.reload();const section=page.getByRole('region',{name:'Functional product comparisons'});await section.waitFor();const body=await section.innerText();for(const expected of ['Functional comparable only','Both source titles','14.00 USD','B0HGNRNC8M','2026-10-12T17:02:48.797Z','ev_5a16ad30c77d6155567f2fb91f76e43e679e3434','Demand: unknown','Deferred for evidence','Dimensions, capacity and material equivalence are unverified'])assert.ok(body.includes(expected),expected);assert.equal(await section.locator('img').count(),0);assert.ok(!body.includes('Windshield'));await page.screenshot({path:path.join(out,'desktop.png'),fullPage:true});await page.setViewportSize({width:390,height:844});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),true);await section.screenshot({path:path.join(out,'mobile.png')});assert.deepEqual(errors,[]);fs.writeFileSync(path.join(out,'visible.txt'),body);fs.writeFileSync(path.join(out,'receipt.json'),JSON.stringify({status:'PASS_CONNECTED_CANONICAL_COMPARABLES',actualComponent:true,actualProxyRoute:true,authenticatedBackend:true,genuineRetainedReceipts:true,anonymous401:true,owner200:true,desktop:[1365,900],mobile:[390,844],horizontalOverflow:false,externalEffects:0,modelCalls:0,requests,limitations:['Native component/proxy examination; not production deployment or owner personal acceptance.']},null,2));}finally{await browser.close();await new Promise<void>(r=>server.close(()=>r()))}
