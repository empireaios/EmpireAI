  "healthMonitoringRulesEnabled": true,
  "validationRulesEnabled": true,
  "loggingLevel": "info",
  "autoRecover": true,
  "maxRegisteredConnectors": 50,
  "isolateConnectors": true,
  "maskSensitiveValues": true
