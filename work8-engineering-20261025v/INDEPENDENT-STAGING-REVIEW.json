  "findingsResolved": [
    "Operator guard lifetime generation lease closes before-first/after-last child gap",
    "Explicit trusted guard role; no runtime root admission bypass",
    "Native syscall policy rejects process descendants and group escape while retaining threads",
    "Capture receipt checks lifecycle revision, exact cohort and stopping state",
    "Emergency marker and audit fence preserve capture invalidation",
    "Broker admission and send/signal results reflect actual controller-owned child",
    "Hosted fixture capture begins from authoritative census, not fixed startup sleep"
  ],
  "limitations": [
    "Backend/Pillow compilation unavailable locally and required in targeted hosted job",
    "Actual Node22 Docker graph fixture not executed; owner exact-tree publication approval required",
    "Native artifact target libc and operator SYS_PTRACE availability must pass hosted examination",
    "Fixture uses synthetic application entries; actual application restoration remains separate",
    "Historical operating membership, safe production cutover and protected custody remain unproven",
    "No complete requirement accepted; baseline45 accepted19 outstanding"
  ],
  "newlyAcceptedWholeRows": []
}
