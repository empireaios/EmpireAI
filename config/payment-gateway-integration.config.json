{
  "enabled": true,
  "useSandbox": true,
  "gatewayRegistrationRulesEnabled": true,
  "authenticationRulesEnabled": true,
  "paymentProcessingRulesEnabled": true,
  "webhookRulesEnabled": true,
  "connectionTimeoutMs": 30000,
  "maxRetryAttempts": 3,
  "retryDelayMs": 1000,
  "retryBackoffMultiplier": 2,
