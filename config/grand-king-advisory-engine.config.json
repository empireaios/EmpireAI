{
  "enabled": true,
  "advisoryGenerationRulesEnabled": true,
  "priorityRulesEnabled": true,
  "recommendationThreshold": 55,
  "validationRulesEnabled": true,
  "retryPolicyAttempts": 3,
  "timeoutMs": 5000,
