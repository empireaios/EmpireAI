  "enabled": true,
  "certificationScope": "full",
  "requiredValidationRulesEnabled": true,
  "passThresholdPercent": 85,
  "failureDetectionRulesEnabled": true,
  "maxRetryAttempts": 3,
  "retryDelayMs": 1000,
  "retryBackoffMultiplier": 2,
  "requestTimeoutMs": 60000,
  "healthMonitoringRulesEnabled": true,
