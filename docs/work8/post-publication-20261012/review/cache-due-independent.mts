import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {IntelligenceStore} from './business-owner/backend/src/intelligence/store.ts';import {ReadAcquirer} from './business-owner/backend/src/intelligence/acquisition.ts';import {runIntelligenceJob} from './business-owner/backend/src/intelligence/runtime.ts';import {digest} from './business-owner/backend/src/intelligence/model.ts';
const dir=fs.mkdtempSync(path.join(os.tmpdir(),'due-independent-'));let time=Date.parse('2026-10-12T12:39:16Z');const s=new IntelligenceStore(path.join(dir,'intel.sqlite'),()=>time);const w='exam';let calls=0;
try{s.seed(w);for(const schedule of s.schedules(w))if(schedule.id!=='internet.safety')s.setSchedule(w,schedule.id,false);const subject=s.schedules(w).find(r=>r.id==='internet.safety')!.subject,facts={response:[]};const old={id:'independent-old',capabilityId:'internet.safety',eye:'INTERNET' as const,provider:'CPSC',endpoint:'/recall',subject,observedAt:new Date(time-21600000).toISOString(),retrievedAt:new Date(time-21600000).toISOString(),staleAfter:new Date(time+1).toISOString(),authenticity:'LIVE_PROVIDER' as const,facts,digest:digest(facts),jobId:'prior',quality:['EXPLICITLY_CONTROLLED_EXAMINATION'],lineage:['fixture'],grantsAuthority:false as const};s.evidence(w,old);const due=s.due(w);assert.equal(due.length,1);const j=s.job(w,due[0]!.lastJobId)!;assert.equal(j.requester,'SCHEDULER');assert.equal(j.createdAt,new Date(time).toISOString());const next=s.schedules(w).find(r=>r.id==='internet.safety')!.nextAt;const result=await runIntelligenceJob(s,w,new ReadAcquirer(s,async()=>{calls++;return Response.json([]);}),j.id,false);assert.equal(calls,1);assert.equal(result!.status,'COMPLETED');assert.notEqual(result!.evidence[0],old.id);assert.equal(s.schedules(w).find(r=>r.id==='internet.safety')!.nextAt,next);assert.deepEqual(s.get(w,'evidence',old.id),old);console.log(JSON.stringify({status:'PASS',scope:'actual due→admission→collector',requests:calls,nextAt:next,oldEvidenceUnchanged:true,commerceEffects:result!.commerceEffects}));}finally{fs.rmSync(dir,{recursive:true,force:true});}
