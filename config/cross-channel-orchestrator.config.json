{
  "enabled": true,
  "channelSynchronizationRulesEnabled": true,
  "campaignCoordinationRulesEnabled": true,
  "journeyCoordinationRulesEnabled": true,
  "validationRulesEnabled": true,
  "healthMonitoringRulesEnabled": true,
