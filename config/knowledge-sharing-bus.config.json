{
  "enabled": true,
  "submissionRulesEnabled": true,
  "classificationRulesEnabled": true,
  "publicationRulesEnabled": true,
  "subscriptionRulesEnabled": true,
  "versioningRulesEnabled": true,
  "archivalRulesEnabled": true,
  "validationRulesEnabled": true,
  "knowledgeCategories": [
    "lessons_learned",
