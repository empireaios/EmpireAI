+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {spawnSync} from 'node:child_process';import {createHash} from 'node:crypto';
+// Only the actual persistence/session adapters are loaded: no host, model, Redis or live authority.
+test('A8 original product-bound transcript survives writer exit and two independent cold readers',()=>{
+ const root=fs.mkdtempSync(path.join(os.tmpdir(),'a8-cold-history-'));
+ try{
+  const context={reference:{kind:'SOURCE_DOSSIER',candidateId:'original',contextDigest:'a'.repeat(64)},label:'Historical product',productId:'product-original',variantId:'variant-original',sku:'SKU-original',phase:'DEFERRED',classification:'SOURCE_DOSSIER',sourceClassification:'REAL_READ_ONLY',source:'VERIFIED_SOURCE_DOSSIER',grantsAuthority:false,rule:'Synthetic retained-context persistence examination only',qualification:{owner:'original-owner',workspace:'workspace',supplier:{stock:null,freight:{amount:null}},sources:[{id:'original',version:1}]}};
+  const turns=[{role:'user',content:'Explain this exact retained variant',timestamp:'2026-10-18T00:00:00.000Z',requestId:'original-request',productContext:context},{role:'assistant',content:'Fixture response: stock and freight remain unknown; no inference occurred.',timestamp:'2026-10-18T00:00:01.000Z',requestId:'original-request'}];
+  fs.writeFileSync(path.join(root,'input.json'),JSON.stringify(turns));
+  const script=`import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';
+import {ReasoningState} from ${JSON.stringify(new URL('../../orchestration/pillow-host/reasoning-state.ts',import.meta.url).href)};
+import {PillowSessionStore} from ${JSON.stringify(new URL('../../orchestration/pillow-host/session-store.ts',import.meta.url).href)};
+const [mode,root]=process.argv.slice(2),file=path.join(root,'reasoning.sqlite'),store=new PillowSessionStore(()=>new ReasoningState(file)),workspace='workspace:original-owner',expected=JSON.parse(fs.readFileSync(path.join(root,'input.json'),'utf8'));
+if(mode==='write'){const {session}=store.getOrCreate(workspace);session.conversationHistory=expected;store.persist(session);fs.writeFileSync(path.join(root,'identity.json'),JSON.stringify({workspace,sessionId:session.sessionId}));console.log(JSON.stringify({phase:mode,pid:process.pid,sessionId:session.sessionId}));}
+else{const identity=JSON.parse(fs.readFileSync(path.join(root,'identity.json'),'utf8')),session=store.get(identity.workspace,identity.sessionId);assert.ok(session);assert.equal(session.sessionId,identity.sessionId);assert.deepEqual(session.conversationHistory,expected);assert.equal(session.approvalState,'none');assert.equal(session.currentMission,null);assert.equal(store.get('workspace:foreign-owner',identity.sessionId),null);assert.equal(store.get('foreign-workspace:original-owner',identity.sessionId),null);assert.equal(store.getOrCreate(identity.workspace).session.sessionId,identity.sessionId);console.log(JSON.stringify({phase:mode,pid:process.pid,sessionId:session.sessionId,turns:session.conversationHistory,approvalState:session.approvalState,currentMission:session.currentMission}));}`;
+  const child=path.join(root,'child.mjs');fs.writeFileSync(child,script);
+  const run=(phase:string)=>{const result=spawnSync(process.execPath,['--import',new URL('../../../node_modules/tsx/dist/loader.mjs',import.meta.url).pathname,child,phase,root],{encoding:'utf8',timeout:15000,env:{PATH:process.env.PATH}});assert.ifError(result.error);assert.equal(result.signal,null);assert.equal(result.status,0,result.stderr);return JSON.parse(result.stdout.trim());};
+  // spawnSync returns only after the writer terminates; readers cannot reuse its process state.
+  const writer=run('write'),first=run('read'),second=run('read-again');assert.equal(new Set([writer.pid,first.pid,second.pid]).size,3);assert.equal(first.sessionId,writer.sessionId);assert.equal(second.sessionId,writer.sessionId);assert.deepEqual(first.turns,turns);assert.deepEqual(second.turns,turns);
+  const receipt={status:'PASS_SCOPED_COLD_PROCESS_TRANSCRIPT',writerPid:writer.pid,readerPids:[first.pid,second.pid],sessionId:writer.sessionId,turnsSha256:createHash('sha256').update(JSON.stringify(turns)).digest('hex'),paidInference:0,externalEffects:0,scope:'Actual ReasoningState and PillowSessionStore only. Writer terminated before independent cold readers; canonical identity, full product/source/version/unknown fields and owner/workspace isolation preserved. No HTTP authentication, Redis or full application restoration claim.'};
+  console.log(JSON.stringify(receipt));
+ }finally{fs.rmSync(root,{recursive:true,force:true});}
+});
