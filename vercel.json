{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/pillow-integrated-closure-20260920": false,
      "ci/provider-readback-amazon-v1": false,
      "ci/provider-readback-cj-v1": false,
      "ci/pillow-priority-a-20261002": false
    }
  }
}
