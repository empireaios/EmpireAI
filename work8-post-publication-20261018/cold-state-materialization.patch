+import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import crypto from 'node:crypto';import {createRequire} from 'node:module';import {DatabaseSync} from 'node:sqlite';import {test} from 'node:test';
+const require=createRequire(import.meta.url),{verifyColdState,materializeColdState}=require('../../../../deployment/work8-cold-state-materialization.cjs');
+const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
+function fixture(t){
+ const root=fs.mkdtempSync(path.join(os.tmpdir(),'work8-cold-state-'));t.after(()=>fs.rmSync(root,{recursive:true,force:true}));
+ const directory=path.join(root,'capture'),destination=path.join(root,'restored');fs.mkdirSync(directory,{mode:0o700});fs.mkdirSync(path.join(directory,'payload'),{mode:0o700});
+ const contract={sourceCommit:'a'.repeat(40),frontendRevision:'b'.repeat(40),entries:[{id:'brain',target:'commissioning/brain.sqlite',kind:'sqlite'},{id:'authority',target:'shadow/authority.json',kind:'json'},{id:'redis',target:'sealed-redis.json',kind:'redis'},{id:'marker',target:'finance/evidence.sqlite.initialized',kind:'bytes'}],directories:['visual/records','continuity']};
+ const db=new DatabaseSync(path.join(directory,'payload/brain'));db.exec("CREATE TABLE records(id TEXT PRIMARY KEY,value TEXT);INSERT INTO records VALUES('original','retained')");db.close();
+ fs.writeFileSync(path.join(directory,'payload/authority'),JSON.stringify({birth:'NOT_BORN',commerce:'LOCKED',approvals:[]}));fs.writeFileSync(path.join(directory,'payload/redis'),JSON.stringify([{key:Buffer.from('session').toString('base64'),dump:Buffer.from('opaque-test-dump').toString('base64'),ttl:1000}]));fs.writeFileSync(path.join(directory,'payload/marker'),'initialized');
+ const manifest={schema:'WORK8_COLD_STATE_MANIFEST_V1',sourceCommit:contract.sourceCommit,frontendRevision:contract.frontendRevision,inventoryComplete:true,bootAllowed:false,noExecutionAuthority:true,directories:contract.directories,entries:contract.entries.map(e=>{const b=fs.readFileSync(path.join(directory,'payload',e.id));return {...e,size:b.length,sha256:sha(b)};})};
+ function seal(){const bytes=JSON.stringify(manifest);fs.writeFileSync(path.join(directory,'cold-state.json'),bytes);return sha(bytes);}
+ const f={root,directory,destination,contract,manifest,seal,digest:seal()};return f;
+}
+test('materializes pinned closed inventory into a fresh target without changing source or enabling boot',t=>{
+ const f=fixture(t),before=fs.readFileSync(path.join(f.directory,'cold-state.json'));const result=materializeColdState(f);
+ assert.equal(result.receipt.bootAllowed,false);assert.equal(result.receipt.redisActivated,false);assert.equal(result.receipt.sourceQuarantineProven,false);assert.equal(result.receipt.noExecutionAuthority,true);
+ for(const e of f.manifest.entries)assert.equal(sha(fs.readFileSync(path.join(f.destination,e.target))),e.sha256);
+ for(const d of f.contract.directories)assert.deepEqual(fs.readdirSync(path.join(f.destination,d)),[]);
+ assert.deepEqual(fs.readFileSync(path.join(f.directory,'cold-state.json')),before);assert.equal(fs.existsSync(f.destination+'.restore-lock'),false);
+ const db=new DatabaseSync(path.join(f.destination,'commissioning/brain.sqlite'),{readOnly:true});try{assert.equal(db.prepare('SELECT value FROM records').get().value,'retained');}finally{db.close();}
+});
+test('rejects inspection archives and incomplete inventory despite self-consistent digests',t=>{
+ const f=fixture(t);f.manifest.schema='WORK8_RUNTIME_RECOVERY_SET_V1';assert.throws(()=>materializeColdState({...f,digest:f.seal()}),/COMPLETE_MANIFEST_REQUIRED/);f.manifest.schema='WORK8_COLD_STATE_MANIFEST_V1';f.manifest.inventoryComplete=false;assert.throws(()=>materializeColdState({...f,digest:f.seal()}),/INCOMPLETE/);f.manifest.inventoryComplete=true;f.manifest.entries.pop();assert.throws(()=>materializeColdState({...f,digest:f.seal()}),/CONTRACT_MISMATCH/);assert.equal(fs.existsSync(f.destination),false);
+});
+test('rejects digest tampering and unexpected payload files',t=>{
+ const f=fixture(t);fs.appendFileSync(path.join(f.directory,'payload/marker'),'tamper');assert.throws(()=>materializeColdState(f),/SIZE|DIGEST/);fs.writeFileSync(path.join(f.directory,'payload/marker'),'initialized');fs.writeFileSync(path.join(f.directory,'payload/extra'),'unknown');assert.throws(()=>materializeColdState(f),/CONTRACT_MISMATCH/);assert.equal(fs.existsSync(f.destination),false);
+});
+test('rejects aliased, linked and partial destinations without modifying them',t=>{
+ const f=fixture(t);assert.throws(()=>materializeColdState({...f,destination:path.join(f.directory,'target')}),/ALIAS/);fs.mkdirSync(f.destination);fs.writeFileSync(path.join(f.destination,'existing'),'preserve');assert.throws(()=>materializeColdState(f),/NOT_FRESH/);assert.equal(fs.readFileSync(path.join(f.destination,'existing'),'utf8'),'preserve');
+ fs.symlinkSync(f.directory,path.join(f.root,'linked'));assert.throws(()=>verifyColdState({...f,directory:path.join(f.root,'linked')}),/SYMLINK/);
+ fs.renameSync(path.join(f.directory,'payload/marker'),path.join(f.root,'marker'));fs.symlinkSync(path.join(f.root,'marker'),path.join(f.directory,'payload/marker'));assert.throws(()=>verifyColdState(f),/SYMLINK/);
+});
+test('rejects traversal, duplicated paths and parent/file collisions in pinned contract',t=>{
+ const f=fixture(t),copy=()=>structuredClone(f.contract);let contract=copy();contract.entries[0].target='../escape';assert.throws(()=>verifyColdState({...f,contract}),/RELATIVE_PATH/);contract=copy();contract.entries[1].target=contract.entries[0].target;assert.throws(()=>verifyColdState({...f,contract}),/DUPLICATE/);contract=copy();contract.entries[1].target='commissioning';assert.throws(()=>verifyColdState({...f,contract}),/PATH_COLLISION/);
+});
+test('copy failure cleans new staging and never leaves a final target or admission marker',t=>{
+ const f=fixture(t);const original=fs.writeFileSync;let injected=false;
+ fs.writeFileSync=function(file,...args){if(String(file).includes('.work8-cold-stage-')&&!injected){injected=true;throw Error('INJECTED_WRITE_FAILURE');}return original.call(this,file,...args);};
+ try{assert.throws(()=>materializeColdState(f),/INJECTED_WRITE_FAILURE/);}finally{fs.writeFileSync=original;}
+ assert.equal(injected,true);assert.equal(fs.existsSync(f.destination),false);assert.equal(fs.existsSync(f.destination+'.restore-lock'),false);assert.deepEqual(fs.readdirSync(f.root),['capture']);
+});
+test('existing crash lock fails closed without stealing it',t=>{
+ const f=fixture(t);fs.mkdirSync(f.destination+'.restore-lock');assert.throws(()=>materializeColdState(f),/EEXIST/);assert.equal(fs.existsSync(f.destination),false);assert.ok(fs.statSync(f.destination+'.restore-lock').isDirectory());
+});
+
+test('dangling target symlinks and hard-linked payloads are not fresh isolated state',t=>{
+ const f=fixture(t);fs.symlinkSync(path.join(f.root,'missing'),f.destination);assert.throws(()=>materializeColdState(f),/NOT_FRESH/);assert.ok(fs.lstatSync(f.destination).isSymbolicLink());fs.unlinkSync(f.destination);
+ fs.linkSync(path.join(f.directory,'payload/marker'),path.join(f.root,'marker-link'));assert.throws(()=>materializeColdState(f),/UNSAFE_FILE/);assert.equal(fs.existsSync(f.destination),false);
+});
diff --git a/deployment/work8-cold-state-materialization.cjs b/deployment/work8-cold-state-materialization.cjs
new file mode 100644
index 00000000..c1a46f53
--- /dev/null
+++ b/deployment/work8-cold-state-materialization.cjs
@@ -0,0 +1,75 @@
+'use strict';
+/** Cold file materialization only. The caller independently pins the complete
+ * inventory contract and source identity. This validates bytes/coverage against
+ * that contract; it cannot prove writer exclusion, source quarantine, Redis
+ * restoration, operational readiness or protected custody. No runtime calls. */
+const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
+const assert=require('node:assert/strict');
+const {DatabaseSync}=require('node:sqlite');
+const {pathToFileURL}=require('node:url');
+const SCHEMA='WORK8_COLD_STATE_MANIFEST_V1',CLOSED='.work8-cold-state.json';
+const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
+const equal=(a,b)=>assert.deepEqual(a,b,'COLD_STATE_CONTRACT_MISMATCH');
+function canonical(p){assert.ok(path.isAbsolute(p)&&path.resolve(p)===p,'COLD_STATE_CANONICAL_PATH');assert.equal(fs.realpathSync(p),p,'COLD_STATE_SYMLINK');}
+function relative(p){assert.ok(typeof p==='string'&&p.length>0&&p.length<1024&&!p.includes('\\')&&!p.includes('\0')&&!path.isAbsolute(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'),'COLD_STATE_RELATIVE_PATH');assert.notEqual(p,CLOSED,'COLD_STATE_RESERVED_PATH');}
+function absent(p){try{fs.lstatSync(p);return false;}catch(error){if(error.code==='ENOENT')return true;throw error;}}
+function sync(p){const fd=fs.openSync(p,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{fs.fsyncSync(fd);}finally{fs.closeSync(fd);}}
+function fileBytes(p,max=268435456){canonical(p);const stat=fs.lstatSync(p);assert.ok(stat.isFile()&&stat.nlink===1&&stat.size<=max,'COLD_STATE_UNSAFE_FILE');const fd=fs.openSync(p,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW);try{const actual=fs.fstatSync(fd);assert.ok(actual.dev===stat.dev&&actual.ino===stat.ino,'COLD_STATE_SOURCE_CHANGED');return fs.readFileSync(fd);}finally{fs.closeSync(fd);}}
+function planInventory(contract){
+ assert.match(contract.sourceCommit,/^[a-f0-9]{40}$/);assert.match(contract.frontendRevision,/^[a-f0-9]{40}$/);
+ assert.ok(Array.isArray(contract.entries)&&contract.entries.length>0&&contract.entries.length<=10000,'COLD_STATE_INVENTORY_REQUIRED');
+ assert.ok(Array.isArray(contract.directories),'COLD_STATE_DIRECTORIES_REQUIRED');
+ const ids=new Set(),paths=new Set();
+ for(const e of contract.entries){assert.match(e.id,/^[a-zA-Z0-9_-]{1,100}$/);relative(e.target);assert.ok(['sqlite','json','redis','bytes'].includes(e.kind));assert.ok(!ids.has(e.id)&&!paths.has(e.target),'COLD_STATE_DUPLICATE');ids.add(e.id);paths.add(e.target);}
+ const dirs=new Set();for(const d of contract.directories){relative(d);assert.ok(!dirs.has(d)&&!paths.has(d),'COLD_STATE_PATH_COLLISION');dirs.add(d);}
+ for(const p of [...paths,...dirs])for(let parent=path.posix.dirname(p);parent!=='.';parent=path.posix.dirname(parent))assert.ok(!paths.has(parent),'COLD_STATE_PATH_COLLISION');
+ return [...contract.entries].sort((a,b)=>a.id.localeCompare(b.id));
+}
+function validatePayload(kind,bytes,file){
+ if(kind==='json'||kind==='redis'){
+  const value=JSON.parse(bytes);assert.ok(value&&typeof value==='object','COLD_STATE_JSON');
+  if(kind==='redis'){
+   assert.ok(Array.isArray(value),'COLD_STATE_REDIS');const keys=new Set();
+   for(const row of value){assert.ok(typeof row.key==='string'&&typeof row.dump==='string'&&Number.isSafeInteger(row.ttl)&&row.ttl>=-1,'COLD_STATE_REDIS_ROW');
+    for(const s of [row.key,row.dump])assert.equal(Buffer.from(s,'base64').toString('base64'),s,'COLD_STATE_REDIS_ENCODING');assert.ok(!keys.has(row.key),'COLD_STATE_REDIS_DUPLICATE');keys.add(row.key);}
+  }
+ }
+ if(kind==='sqlite'){
+  assert.equal(bytes.subarray(0,16).toString(),'SQLite format 3\0','COLD_STATE_SQLITE');assert.equal(bytes[18],1,'COLD_STATE_SQLITE_MUST_BE_SEALED_DELETE_MODE');
+  const db=new DatabaseSync(pathToFileURL(file).href+'?immutable=1',{readOnly:true,allowExtension:false});
+  try{equal(db.prepare('PRAGMA integrity_check').all().map(r=>r.integrity_check),['ok']);}finally{db.close();}
+ }
+}
+function verifyColdState({directory,digest,contract}){
+ canonical(directory);assert.match(digest,/^[a-f0-9]{64}$/);const expected=planInventory(contract);
+ const bytes=fileBytes(path.join(directory,'cold-state.json'),1048576);assert.equal(sha(bytes),digest,'COLD_STATE_MANIFEST_DIGEST');const m=JSON.parse(bytes);
+ assert.equal(m.schema,SCHEMA,'COLD_STATE_COMPLETE_MANIFEST_REQUIRED');assert.equal(m.inventoryComplete,true,'COLD_STATE_INCOMPLETE');assert.equal(m.bootAllowed,false);assert.equal(m.noExecutionAuthority,true);
+ equal(m.sourceCommit,contract.sourceCommit);equal(m.frontendRevision,contract.frontendRevision);
+ assert.ok(Array.isArray(m.entries));equal(m.entries.map(({id,target,kind})=>({id,target,kind})).sort((a,b)=>a.id.localeCompare(b.id)),expected);
+ equal([...m.directories].sort(),[...contract.directories].sort());
+ equal(fs.readdirSync(directory).sort(),['cold-state.json','payload']);canonical(path.join(directory,'payload'));
+ equal(fs.readdirSync(path.join(directory,'payload')).sort(),m.entries.map(e=>e.id).sort());
+ for(const e of m.entries){assert.match(e.sha256,/^[a-f0-9]{64}$/);assert.ok(Number.isSafeInteger(e.size)&&e.size>=0);const file=path.join(directory,'payload',e.id),b=fileBytes(file);assert.equal(b.length,e.size,'COLD_STATE_SIZE');assert.equal(sha(b),e.sha256,'COLD_STATE_DIGEST');validatePayload(e.kind,b,file);}
+ return m;
+}
+function materializeColdState({directory,digest,contract,destination}){
+ const m=verifyColdState({directory,digest,contract});const parent=path.dirname(destination);canonical(parent);assert.equal(path.resolve(destination),destination);
+ assert.ok(destination!==directory&&!destination.startsWith(directory+path.sep)&&!directory.startsWith(destination+path.sep),'COLD_STATE_SOURCE_TARGET_ALIAS');
+ const parentStat=fs.statSync(parent);assert.equal(parentStat.uid,process.getuid(),'COLD_STATE_PARENT_OWNER');assert.equal(parentStat.mode&0o077,0,'COLD_STATE_PARENT_PRIVATE');
+ assert.ok(absent(destination),'COLD_STATE_TARGET_NOT_FRESH');
+ const lock=destination+'.restore-lock';fs.mkdirSync(lock,{mode:0o700});const lockIdentity=fs.lstatSync(lock);let stage,renamed=false;
+ try{
+  stage=fs.mkdtempSync(path.join(parent,'.work8-cold-stage-'));fs.chmodSync(stage,0o700);
+  for(const d of m.directories)fs.mkdirSync(path.join(stage,d),{recursive:true,mode:0o700});
+  for(const e of m.entries){const target=path.join(stage,e.target);fs.mkdirSync(path.dirname(target),{recursive:true,mode:0o700});const b=fileBytes(path.join(directory,'payload',e.id));assert.equal(sha(b),e.sha256,'COLD_STATE_SOURCE_CHANGED');fs.writeFileSync(target,b,{flag:'wx',mode:0o600});sync(target);validatePayload(e.kind,fileBytes(target),target);}
+  // Recheck the pinned complete inventory after copying, before any final path exists.
+  verifyColdState({directory,digest,contract});
+  const receipt={schema:'WORK8_COLD_STATE_MATERIALIZED_V1',digest,sourceCommit:m.sourceCommit,frontendRevision:m.frontendRevision,inventoryCompleteRelativeToPinnedContract:true,bootAllowed:false,noExecutionAuthority:true,redisActivated:false,sourceQuarantineProven:false};
+  fs.writeFileSync(path.join(stage,CLOSED),JSON.stringify(receipt),{flag:'wx',mode:0o600});sync(path.join(stage,CLOSED));
+  const flush=p=>{for(const name of fs.readdirSync(p)){const child=path.join(p,name);if(fs.lstatSync(child).isDirectory())flush(child);}sync(p);};flush(stage);
+  assert.ok(absent(destination),'COLD_STATE_TARGET_NOT_FRESH');fs.renameSync(stage,destination);renamed=true;sync(parent);
+  return {directory:destination,receipt};
+ }catch(error){if(stage)fs.rmSync(renamed?destination:stage,{recursive:true,force:true});throw error;}
+ finally{const current=fs.lstatSync(lock);assert.ok(current.isDirectory()&&current.dev===lockIdentity.dev&&current.ino===lockIdentity.ino,'COLD_STATE_LOCK_IDENTITY_CHANGED');fs.rmdirSync(lock);sync(parent);}
+}
+module.exports={verifyColdState,materializeColdState};
