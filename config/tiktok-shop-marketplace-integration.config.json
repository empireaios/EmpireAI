  "validationRulesEnabled": true,
  "healthMonitoringRulesEnabled": true,
  "loggingLevel": "info",
  "autoRecover": true,
  "credentialRef": "vault://tiktok-shop-open-api",
  "defaultShopId": null,
  "maskSensitiveValues": true
}
