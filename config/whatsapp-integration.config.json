{
  "enabled": true,
  "messagingRulesEnabled": true,
  "templateRulesEnabled": true,
  "conversationRulesEnabled": true,
  "validationRulesEnabled": true,
  "duplicateDetectionEnabled": true,
  "connectionTimeoutMs": 30000,
